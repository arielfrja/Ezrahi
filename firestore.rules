rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    // The requesting user has a participant document in the event
    function isEventParticipant(eventId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid));
    }

    // The requesting user manages the event
    function isEventManager(eventId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/events/$(eventId)).data.managerId == request.auth.uid;
    }

    // Participants AND managers may access event content (participant list,
    // live locations, messages). Managers are not necessarily participants.
    function canAccessEvent(eventId) {
      return isSignedIn() && (isEventParticipant(eventId) || isEventManager(eventId));
    }

    // ---------------------------------------------------------------
    // 0. User profiles: users manage only their own profile document
    //    (document id == Firebase Auth uid; written by registerUser)
    // ---------------------------------------------------------------
    match /Users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // 1. Reports (legacy top-level collection, still the app's live
    //    report path; documents carry ActId -> eventId). Signed-in users
    //    may read reports and create reports under their own ReporterId.
    // ---------------------------------------------------------------
    match /Reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ReporterId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // 3. Settings (dynamic role options, future app settings).
    //    Readable by signed-in users; managed via admin tooling only.
    // ---------------------------------------------------------------
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // 2. Events
    // ---------------------------------------------------------------
    match /events/{eventId} {
      // Anyone logged in can read an event or create one
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Only the manager may modify/delete an event
      allow update, delete: if isEventManager(eventId);

      // 2.1 Participants sub-collection (Live Location Tracking)
      match /participants/{userId} {
        // Participants and managers may read all participant locations
        allow read: if canAccessEvent(eventId);
        // A user can create/overwrite/delete their OWN document; the event
        // manager may also write (e.g. assign/change participant roles)
        allow write: if isSignedIn() && (request.auth.uid == userId || isEventManager(eventId));
      }

      // 2.2 Direct messages: one sub-collection per participant pair.
      //     Pair id = sorted "uidA_uidB"; only the two participants may
      //     read or write it.
      match /direct/{pairId} {
        function isPairMember() {
          return pairId.split("_").hasAny([request.auth.uid]);
        }
        allow read: if isSignedIn() && canAccessEvent(eventId) && isPairMember();
        allow write: if false;
        match /messages/{messageId} {
          allow read: if isSignedIn() && canAccessEvent(eventId) && isPairMember();
          allow create: if isSignedIn() && isPairMember() &&
            request.resource.data.senderId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      // 2.2 Messages sub-collection
      match /messages/{messageId} {
        allow read: if canAccessEvent(eventId);
        // Only an event participant can send, and only their own messages
        allow create: if isEventParticipant(eventId) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }

      // 2.3 Routes sub-collection (planned GPX trails). Route management
      //     (create/update/delete/activate) is allowed for the manager and
      //     for any participant whose role or uid the manager explicitly
      //     permitted via the event doc fields routeAllowedRoles /
      //     routeAllowedUids (dynamically toggled from the app).
      function isRoutePermitted(eventId) {
        return get(/databases/$(database)/documents/events/$(eventId)).data.managerId == request.auth.uid ||
          (get(/databases/$(database)/documents/events/$(eventId)).data.routeAllowedUids is list &&
            request.auth.uid in get(/databases/$(database)/documents/events/$(eventId)).data.routeAllowedUids) ||
          (exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/events/$(eventId)).data.routeAllowedRoles is list &&
            get(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid)).data.role in
              get(/databases/$(database)/documents/events/$(eventId)).data.routeAllowedRoles);
      }
      match /routes/{routeId} {
        allow read: if canAccessEvent(eventId);
        allow create: if isRoutePermitted(eventId) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.storagePath is string &&
          request.resource.data.storagePath.matches('gpx/.*') &&
          request.resource.data.uploadedBy == request.auth.uid;
        allow update, delete: if isRoutePermitted(eventId);
      }
    }

    // ---------------------------------------------------------------
    // 4. App error logging (spec docs/specs/todo-fix-6-exception-logging.md).
    //    Clients may CREATE records (authenticated under their own uid, or
    //    anonymous pre-auth under the anon- namespace); records are
    //    immutable and unreadable from the app (query via console/gcloud).
    // ---------------------------------------------------------------
    match /app_errors/{errorId} {
      allow create: if request.resource.data.id == errorId
        && request.resource.data.timestamp is number
        && request.resource.data.timestamp <= request.time.toMillis() + 300000    // no future-dating > 5 min
        && request.resource.data.timestamp >= request.time.toMillis() - 86400000  // flush window: backdate <= 24 h
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2048
        && request.resource.data.stackTrace is string
        && request.resource.data.stackTrace.size() <= 8192
        && ( (request.auth != null && request.resource.data.userId == request.auth.uid)
          || (request.auth == null && request.resource.data.userId.matches('^anon-.*')) );
      allow read: if false;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // 3. Collection-group access (event picker: getUserEvents queries
    //    collectionGroup("participants")). Firestore requires a
    //    {path=**} rule for collection-group queries. A user may only
    //    list participant documents that belong to them — i.e. the
    //    events they joined.
    // ---------------------------------------------------------------
    match /{path=**}/participants/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
