rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // GPX route files: any signed-in user may read/write files under
    // gpx/{eventId}/{uid}/**. The real authority is Firestore rules on
    // events/{eventId}/routes — a route doc (which carries the download
    // URL that everyone renders) can only be created by the manager or a
    // participant whose role/uid the manager permitted.
    match /gpx/{eventId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}